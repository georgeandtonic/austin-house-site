---
import Base from '../layouts/Base.astro';
import { link, site } from '../lib/site';
import { architects } from '../data/architects';
import { submarkets } from '../data/submarkets';
import feed from '../../public/data/plots-feed.json';

const sections = [
  {
    href: 'mcm',
    eyebrow: 'The dossier',
    title: 'Mid-Century Modern in Texas',
    body: 'How the California glass box was rewritten for Central Texas heat — orientation, overhangs, thermal mass, the right roof — plus the regional lineage from O’Neil Ford to Lake|Flato, and ten built houses worth studying.',
    meta: '~6,350 words · 7 key principles · 10 case studies',
  },
  {
    href: 'architects',
    eyebrow: 'The shortlist',
    title: 'Austin Architects',
    body: `${architects.length} firms profiled and rated for MCM fit, co-design posture, Texas-heat competence and budget. A Top-5 to interview first, a 25-question interview bank, and how Austin fee structures actually work.`,
    meta: `${architects.length} firms · Top 5 · 25-question interview bank`,
  },
  {
    href: 'land',
    eyebrow: 'The search',
    title: 'Land',
    body: `A criteria spec and ${feed.plots.length} live plots — verified against ACTRIS MLS — across the Hill Country, lake submarkets and close-in Austin. Budget scenarios, a mapped shortlist, and a site-visit checklist.`,
    meta: `${feed.plots.length} live plots · ${submarkets.length} sub-markets · A/B/C budgets`,
  },
];
---

<Base>
  <!-- Hero -->
  <section class="relative overflow-hidden border-b border-line">
    <div
      class="absolute inset-0 -z-10"
      style="background:
        radial-gradient(120% 90% at 85% -10%, rgba(187,90,53,0.10), transparent 55%),
        radial-gradient(90% 80% at 10% 110%, rgba(124,138,107,0.12), transparent 55%);"
    >
    </div>
    <div class="mx-auto max-w-6xl px-5 py-20 sm:px-8 sm:py-28 lg:py-32">
      <p class="eyebrow">Austin metro · A custom mid-century-modern home</p>
      <h1
        class="mt-5 max-w-3xl font-display text-5xl font-semibold leading-[1.04] tracking-tight text-ink sm:text-6xl lg:text-7xl"
      >
        Building a modern house, the way Texas demands.
      </h1>
      <p class="mt-7 max-w-2xl text-lg leading-relaxed text-ink-soft">
        A working monograph for {site.owners} — research consolidated as they design and
        build a mid-century-modern home in the Austin metro. The California dream survives
        the trip here, but only in translation: shade, mass, a roof that drains, and a
        site chosen for the sun. This is the homework, in three parts.
      </p>

      <dl class="mt-10 flex flex-wrap gap-x-10 gap-y-4">
        {
          [
            ['Budget', site.budget],
            ['Timeline', site.timeline],
            ['Style', 'MCM, adapted for Texas heat'],
            ['Principle', 'Right land trumps location'],
          ].map(([k, v]) => (
            <div>
              <dt class="text-[0.65rem] uppercase tracking-[0.16em] text-muted">{k}</dt>
              <dd class="mt-1 font-display text-xl text-ink">{v}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- Section cards -->
  <section class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-20">
    <div class="grid gap-6 lg:grid-cols-3">
      {
        sections.map((s, i) => (
          <a
            href={link(s.href)}
            class="group flex flex-col rounded-sm border border-line bg-card p-7 transition-all hover:-translate-y-1 hover:border-terracotta/50 hover:shadow-[0_18px_40px_-24px_rgba(42,38,34,0.4)]"
          >
            <div class="flex items-center justify-between">
              <p class="eyebrow">{s.eyebrow}</p>
              <span class="font-display text-2xl text-line">0{i + 1}</span>
            </div>
            <h2 class="mt-3 font-display text-3xl font-semibold leading-tight text-ink">
              {s.title}
            </h2>
            <p class="mt-3 flex-1 text-[0.97rem] leading-relaxed text-ink-soft">{s.body}</p>
            <p class="mt-6 text-xs uppercase tracking-[0.12em] text-muted">{s.meta}</p>
            <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-medium text-terracotta-deep">
              Open
              <svg
                class="h-3.5 w-3.5 transition-transform group-hover:translate-x-1"
                viewBox="0 0 16 16"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
              >
                <path d="M3 8h10M9 4l4 4-4 4" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
          </a>
        ))
      }
    </div>

    <!-- Feed callout -->
    <a
      href={link('feed')}
      class="group mt-6 flex flex-col gap-4 rounded-sm border border-dashed border-sage/60 bg-paper-2 p-7 transition-colors hover:border-sage sm:flex-row sm:items-center sm:justify-between"
    >
      <div>
        <p class="eyebrow" style="color:var(--color-sage-deep)">Live · auto-updating</p>
        <h2 class="mt-2 font-display text-2xl font-semibold text-ink">New plot findings</h2>
        <p class="mt-1.5 max-w-xl text-[0.95rem] leading-relaxed text-ink-soft">
          A recurring land-scan agent appends fresh listings to the feed. Newest-first,
          with a “new since your last visit” badge — check back as the search runs.
        </p>
      </div>
      <span
        class="inline-flex shrink-0 items-center gap-1.5 self-start rounded-full border border-sage/60 px-4 py-2 text-sm font-medium text-sage-deep sm:self-center"
      >
        Open the feed
        <svg class="h-3.5 w-3.5 transition-transform group-hover:translate-x-1" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6">
          <path d="M3 8h10M9 4l4 4-4 4" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </span>
    </a>

    <p class="mt-10 text-center text-xs uppercase tracking-[0.14em] text-muted">
      Last updated {site.updated}
    </p>
  </section>
</Base>
