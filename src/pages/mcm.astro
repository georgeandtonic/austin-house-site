---
import Base from '../layouts/Base.astro';
import { renderMarkdown, extractHeadings, stripFirstH1 } from '../lib/markdown';
import dossierRaw from '../content/mcm-texas-dossier.md?raw';

const body = stripFirstH1(dossierRaw);
const html = renderMarkdown(body);
const toc = extractHeadings(body, [2]);
---

<Base
  title="MCM in Texas"
  description="A dossier on adapting mid-century-modern architecture to Central Texas heat — orientation, shading, thermal mass, roofs, materials — and the regional lineage and built case studies."
>
  <!-- Hero -->
  <section class="border-b border-line bg-paper-2">
    <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-20">
      <p class="eyebrow">The dossier</p>
      <h1
        class="mt-4 max-w-3xl font-display text-4xl font-semibold leading-[1.05] tracking-tight text-ink sm:text-6xl"
      >
        Mid-Century Modern Architecture in Texas
      </h1>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-ink-soft">
        Everything that makes classic MCM beautiful — the glass, the openness, the
        dissolved boundary between in and out — is what makes it punishing in Central
        Texas if you don’t modulate it. The good news: building physics gives you a
        clear, ordered playbook.
      </p>
    </div>
  </section>

  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <!-- Mobile TOC -->
    <details class="my-8 rounded-sm border border-line bg-card lg:hidden">
      <summary
        class="cursor-pointer list-none px-5 py-3.5 text-sm font-medium text-ink [&::-webkit-details-marker]:hidden"
      >
        <span class="eyebrow">On this page</span>
      </summary>
      <ol class="border-t border-line px-5 py-3 text-sm">
        {
          toc.map((h, i) => (
            <li class="py-1.5">
              <a href={`#${h.slug}`} class="text-ink-soft hover:text-terracotta-deep">
                <span class="mr-2 text-muted">{String(i + 1).padStart(2, '0')}</span>
                {h.text}
              </a>
            </li>
          ))
        }
      </ol>
    </details>

    <div class="gap-14 py-8 lg:grid lg:grid-cols-[15rem_minmax(0,1fr)] lg:py-16">
      <!-- Desktop sticky TOC -->
      <aside class="hidden lg:block">
        <nav class="sticky top-24" aria-label="Table of contents">
          <p class="eyebrow mb-4">On this page</p>
          <ol class="space-y-2.5 border-l border-line text-sm" id="toc">
            {
              toc.map((h, i) => (
                <li>
                  <a
                    href={`#${h.slug}`}
                    data-slug={h.slug}
                    class="toc-link -ml-px block border-l-2 border-transparent py-0.5 pl-4 leading-snug text-muted transition-colors hover:text-terracotta-deep"
                  >
                    <span class="mr-1.5 text-line">{String(i + 1).padStart(2, '0')}</span>
                    {h.text}
                  </a>
                </li>
              ))
            }
          </ol>
        </nav>
      </aside>

      <!-- Article -->
      <article class="prose-mcm" set:html={html} />
    </div>
  </div>
</Base>

<style>
  .toc-link.is-active {
    color: var(--color-terracotta-deep);
    border-color: var(--color-terracotta);
    font-weight: 500;
  }
</style>

<script>
  // Scroll-spy: highlight the TOC entry for the section in view.
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.toc-link'));
  const bySlug = new Map(links.map((l) => [l.dataset.slug, l]));
  const headings = links
    .map((l) => document.getElementById(l.dataset.slug || ''))
    .filter((el): el is HTMLElement => !!el);

  if (headings.length && 'IntersectionObserver' in window) {
    let activeId = '';
    const setActive = (id: string) => {
      if (id === activeId) return;
      activeId = id;
      links.forEach((l) => l.classList.toggle('is-active', l.dataset.slug === id));
    };
    const io = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
        if (visible[0]) setActive(visible[0].target.id);
      },
      { rootMargin: '-20% 0px -70% 0px', threshold: 0 },
    );
    headings.forEach((h) => io.observe(h));
  }
</script>
